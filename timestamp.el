(defun time-stamp-decode (pair$)
  "Decodes any output of time-stamp-compact."
  (interactive "sEnter Latin-Greek pair: ")
  (let (Latin$ greek$ hour$ pentaminute$)
    (setq Latin$ (substring pair$ 0 1))
    (setq greek$ (substring pair$ 1 2))
    (setq hour$ (cond
      ((string= Latin$ "A") "01")
      ((string= Latin$ "B") "02")
      ((string= Latin$ "C") "03")
      ((string= Latin$ "D") "04")
      ((string= Latin$ "E") "05")
      ((string= Latin$ "F") "06")
      ((string= Latin$ "G") "07")
      ((string= Latin$ "H") "08")
      ((string= Latin$ "I") "09")
      ((string= Latin$ "J") "10")
      ((string= Latin$ "K") "11")
      ((string= Latin$ "L") "12")
      ((string= Latin$ "M") "13")
      ((string= Latin$ "N") "14")
      ((string= Latin$ "O") "15")
      ((string= Latin$ "P") "16")
      ((string= Latin$ "Q") "17")
      ((string= Latin$ "R") "18")
      ((string= Latin$ "S") "19")
      ((string= Latin$ "T") "20")
      ((string= Latin$ "U") "21")
      ((string= Latin$ "V") "22")
      ((string= Latin$ "W") "23")
      ((string= Latin$ "X") "00")))
    (setq pentaminute$ (cond
      ((string= greek$ "α") "05")
      ((string= greek$ "β") "10")
      ((string= greek$ "γ") "15")
      ((string= greek$ "δ") "20")
      ((string= greek$ "ε") "25")
      ((string= greek$ "ζ") "30")
      ((string= greek$ "η") "35")
      ((string= greek$ "θ") "40")
      ((string= greek$ "ι") "45")
      ((string= greek$ "κ") "50")
      ((string= greek$ "λ") "55")
      ((string= greek$ "μ") "00")))
    (message (concat hour$ "⬠" pentaminute$))))
; (describe-function 'time-stamp-decode)

(defun date-stamp-decode (fourchar$)
  "Decodes any output of date-stamp-compact."
  (interactive "sEnter four-character string: ")
  (let (year$ month^ month$ day$)
    (setq year$ (concat (base-100-2-Arabic-pair (substring fourchar$ 0 1))
      (base-100-2-Arabic-pair (substring fourchar$ 1 2))))
    (setq month^ (string-to-number (base-100-2-Arabic-pair (substring fourchar$ 2 3))))
    (setq month$ (cond
      ((= month^ 1) "JAN")
      ((= month^ 2) "FEB")
      ((= month^ 3) "MAR")
      ((= month^ 4) "APR")
      ((= month^ 5) "MAY")
      ((= month^ 6) "JUN")
      ((= month^ 7) "JUL")
      ((= month^ 8) "AUG")
      ((= month^ 9) "SEP")
      ((= month^ 10) "OCT")
      ((= month^ 11) "NOV")
      ((= month^ 12) "DEC")))
    (setq day$ (base-100-2-Arabic-pair (substring fourchar$ 3 4)))
    (message (concat year$ "-" month$ "-" day$))))
; (describe-function 'date-stamp-decode)

(defun now-stamp-decode (sixchar$)
  "Decodes any output of now-stamp."
  (interactive "sEnter six character-string: ")
  (let (fourchar$ twochar$ date$ time$ (d_1! t))
    (setq fourchar$ (substring sixchar$ 0 4))
    (setq twochar$ (substring sixchar$ 4 6))
    (setq date$ (date-stamp-decode fourchar$))
    (setq time$ (time-stamp-decode twochar$))
    (message (concat date$ " " time$))))
; (describe-function 'now-stamp-decode)

(defun DAT-DOTW-stamp ()
  "Like DAT-stamp but with additional space and three-letter all-cap day of the week."
  (interactive)
  (let (string$ year month day DOTW$)
    (setq string$ (concat (format-time-string "%Y") "-" (upcase (format-time-string "%h")) "-" (format-time-string "%d")))
    (setq year (string-to-number (format-time-string "%Y")))
    (setq month (string-to-number (format-time-string "%m")))
    (setq day (string-to-number (format-time-string "%d")))
    (setq DOTW$ (upcase (substring (Doomsday-Rule year month day) 0 3)))
    (setq string$ (concat string$ " " DOTW$))
    (insert string$)))
; (describe-function 'DAT-DOTW-stamp)

(defun DAT-DOTW-stamp ()
  "Like DAT-stamp but with additional space and three-letter all-cap day of the week."
  (interactive)
  (let (string$)
    (setq string$ (concat (format-time-string "%Y") "-" (upcase (format-time-string "%h")) "-" (format-time-string "%d")))
    (setq string$ (concat string$ " " (upcase (format-time-string "%a"))))
    (insert string$)))
; (describe-function 'DAT-DOTW-stamp)

(defun DAT-DOTW-TM-stamp ()
  "Like DAT-DOTW-stamp but with additional space and 12-hour format time."
  (interactive)
  (let (string$)
    (setq string$ (concat (format-time-string "%Y") "-" (upcase (format-time-string "%h")) "-" (format-time-string "%d")))
    (setq string$ (concat string$ " " (upcase (format-time-string "%a"))))
    (setq string$ (concat string$ " " (format-time-string "%l:%M %p")))
    (setq string$ (string-replace "  " " " string$))
    (insert string$)))
; (describe-function 'DAT-DOTW-TM-stamp)


